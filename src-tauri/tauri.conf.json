{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dambo",
  "identifier": "com.dambo.app",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;",
      "capabilities": ["default", "admin-window", "plugin-overlay"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
