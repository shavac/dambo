{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dambo",
  "version": "0.1.0",
  "identifier": "com.dambo.app",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dambo Control Capsule",
        "x": 100,
        "y": 100,
        "width": 740,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
