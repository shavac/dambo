{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dambo",
  "identifier": "com.dambo.app",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dambo Control Capsule",
        "x": 100,
        "y": 100,
        "width": 580,
        "minWidth": 520,
        "maxWidth": 860,
        "height": 56,
        "minHeight": 56,
        "maxHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;",
      "capabilities": ["default", "plugin-overlay"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
