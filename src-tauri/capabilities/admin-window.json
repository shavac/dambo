{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "admin-window",
  "description": "Capability for desktop main window loading local / control panel",
  "local": false,
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://[\\:\\:1]:*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-is-always-on-top",
    "allow-get-plugins",
    "allow-open-plugin-desktop",
    "allow-close-plugin-desktop",
    "allow-open-plugins-dir",
    "allow-open-folder",
    "allow-open-in-browser",
    "allow-set-always-on-top"
  ]
}
