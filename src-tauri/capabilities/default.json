{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for local Bilibili QR sign-in popup window",
  "local": true,
  "windows": ["bili-qr-login"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "allow-get-i18n",
    "allow-refresh-qr-code"
  ]
}
